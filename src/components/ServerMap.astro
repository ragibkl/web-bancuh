---
// A world map with a pin per server location, rendered to static SVG at
// build time. No JavaScript reaches the browser.
import { geoEqualEarth, geoPath } from "d3-geo";
import { feature } from "topojson-client";
import type { FeatureCollection } from "geojson";
import type { Topology, GeometryCollection } from "topojson-specification";

import world from "../data/countries-110m.json";
import { getLocationsWithServers } from "../lib/servers";

const WIDTH = 1000;
const HEIGHT = 480;
const ANTARCTICA = "010";

const topology = world as unknown as Topology<{
  countries: GeometryCollection;
}>;
const all = feature(topology, topology.objects.countries) as FeatureCollection;
const land: FeatureCollection = {
  type: "FeatureCollection",
  features: all.features.filter((f) => f.id !== ANTARCTICA),
};

const projection = geoEqualEarth().fitSize([WIDTH, HEIGHT], land);
const path = geoPath(projection);

const locations = (await getLocationsWithServers()).map((l) => {
  const [x, y] = projection(l.coordinates) ?? [0, 0];
  // Labels on the eastern side of the map go to the left of the pin, so they
  // aren't cut off at the edge.
  const flip = x > WIDTH * 0.6;
  return {
    ...l,
    x,
    y,
    flip,
    label: `${l.name} · ${l.servers.map((s) => s.id).join(", ")}`,
  };
});
---

<figure class="server-map not-content">
  <svg
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    role="img"
    aria-label={`Map of Bancuh DNS server locations: ${locations.map((l) => l.name).join(", ")}`}
  >
    <g class="land">
      {land.features.map((f) => (
        <path d={path(f) ?? undefined} />
      ))}
    </g>
    {locations.map((l) => (
      <g class="pin" transform={`translate(${l.x} ${l.y})`}>
        <circle class="halo" r="14" />
        <circle class="dot" r="6" />
        <text
          x={l.flip ? -12 : 12}
          y="-10"
          text-anchor={l.flip ? "end" : "start"}
        >
          {l.label}
        </text>
      </g>
    ))}
  </svg>
</figure>

<style>
  .server-map {
    margin-block: 1.5rem;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .land path {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-5);
    stroke-width: 0.5;
  }
  .halo {
    fill: var(--sl-color-accent);
    opacity: 0.25;
  }
  .dot {
    fill: var(--sl-color-accent);
    stroke: var(--sl-color-bg);
    stroke-width: 2;
  }
  text {
    font-size: 18px;
    font-weight: 600;
    fill: var(--sl-color-white);
    paint-order: stroke;
    stroke: var(--sl-color-bg);
    stroke-width: 5px;
    stroke-linejoin: round;
  }
</style>
