---
// Asks every server, over IPv4 and IPv6 separately, for the visitor's own
// recent lookups, and shows them as one timeline. Each server only ever
// returns lookups from the address the request came from, and allows this site
// to read them through LOGS_CORS_ORIGINS in dnsdist-acme.
import { getServers } from "../lib/servers";

const servers = (await getServers()).map((s) => ({
  id: s.id,
  location: s.location.name,
  v4: `https://v4.${s.hostname}:8443/api/logs`,
  v6: `https://v6.${s.hostname}:8443/api/logs`,
}));
---

<div class="live-logs not-content" data-servers={JSON.stringify(servers)}>
  <div class="ll-summary" aria-live="polite">
    <span class="ll-chip ll-muted">Checking every server…</span>
  </div>

  <div class="ll-servers"></div>

  <div class="ll-controls">
    <input
      type="search"
      class="ll-filter"
      placeholder="Filter by name"
      aria-label="Filter by name"
    />
    <label>
      <input type="checkbox" class="ll-blocked-only" /> Blocked only
    </label>
    <button type="button" class="ll-live">
      Pause
    </button>
  </div>

  <div class="ll-table-wrap">
    <table class="ll-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Name</th>
          <th>Result</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
  <p class="ll-note"></p>
</div>

<script>
  type Family = "ipv4" | "ipv6";

  type Answer = { name: string; type: string; ttl: number; data: string };
  type Query = {
    seq: number;
    time: string;
    name: string;
    type: string;
    rcode: string;
    blocked: boolean;
    answers: Answer[];
  };
  type ApiResponse = {
    client_ip: string;
    family: Family;
    window_seconds: number;
    cursor: number;
    truncated: boolean;
    queries: Query[];
  };

  type ServerInfo = { id: string; location: string; v4: string; v6: string };

  type Row = Query & { server: string; family: Family; at: number };

  type Endpoint = {
    server: ServerInfo;
    family: Family;
    url: string;
    state: "pending" | "ok" | "error";
    cursor: number | null;
    clientIp: string | null;
    nextPoll: number;
    inFlight: boolean;
  };

  // Servers with lookups refresh often; the rest only now and then, so an
  // open tab costs a couple of requests every few seconds, not fourteen.
  const ACTIVE_EVERY_MS = 5_000;
  const IDLE_EVERY_MS = 30_000;
  const ERROR_EVERY_MS = 60_000;
  const TIMEOUT_MS = 6_000;
  // Live mode stops on its own, so a forgotten tab does not poll all day.
  const LIVE_FOR_MS = 10 * 60_000;
  const MAX_ROWS = 500;

  function setup(root: HTMLElement) {
    const servers: ServerInfo[] = JSON.parse(root.dataset.servers ?? "[]");
    const summary = root.querySelector<HTMLElement>(".ll-summary")!;
    const serverGrid = root.querySelector<HTMLElement>(".ll-servers")!;
    const tableBody = root.querySelector<HTMLElement>(".ll-table tbody")!;
    const note = root.querySelector<HTMLElement>(".ll-note")!;
    const filter = root.querySelector<HTMLInputElement>(".ll-filter")!;
    const blockedOnly =
      root.querySelector<HTMLInputElement>(".ll-blocked-only")!;
    const liveButton = root.querySelector<HTMLButtonElement>(".ll-live")!;

    let windowMs = 600_000;
    let liveUntil = Date.now() + LIVE_FOR_MS;
    const rows = new Map<string, Row>();
    const endpoints: Endpoint[] = servers.flatMap((server) =>
      (["ipv4", "ipv6"] as Family[]).map((family) => ({
        server,
        family,
        url: family === "ipv4" ? server.v4 : server.v6,
        state: "pending" as const,
        cursor: null,
        clientIp: null,
        nextPoll: 0,
        inFlight: false,
      })),
    );

    // One card per server, with a line each for IPv4 and IPv6.
    const cells = new Map<Endpoint, HTMLElement>();
    for (const server of servers) {
      const card = document.createElement("div");
      card.className = "ll-card";
      const title = document.createElement("div");
      title.className = "ll-card-title";
      const id = document.createElement("strong");
      id.textContent = server.id;
      const where = document.createElement("span");
      where.className = "ll-muted";
      where.textContent = server.location;
      title.append(id, where);
      card.append(title);
      for (const ep of endpoints.filter((e) => e.server === server)) {
        const line = document.createElement("div");
        line.className = "ll-card-line";
        const label = document.createElement("span");
        label.className = "ll-muted";
        label.textContent = ep.family === "ipv4" ? "IPv4" : "IPv6";
        const value = document.createElement("span");
        line.append(label, value);
        cells.set(ep, value);
        card.append(line);
      }
      serverGrid.append(card);
    }

    const live = () => Date.now() < liveUntil;
    const countFor = (ep: Endpoint) =>
      [...rows.values()].filter(
        (r) => r.server === ep.server.id && r.family === ep.family,
      ).length;

    async function poll(ep: Endpoint) {
      ep.inFlight = true;
      const url = new URL(ep.url);
      if (ep.cursor === null) {
        url.searchParams.set("limit", "200");
      } else {
        url.searchParams.set("since", String(ep.cursor));
        url.searchParams.set("limit", "1000");
      }

      try {
        const res = await fetch(url, {
          signal: AbortSignal.timeout(TIMEOUT_MS),
          cache: "no-store",
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: ApiResponse = await res.json();

        windowMs = data.window_seconds * 1000;
        ep.state = "ok";
        ep.clientIp = data.client_ip;
        ep.cursor = data.cursor;
        for (const q of data.queries) {
          rows.set(`${ep.server.id}|${ep.family}|${q.seq}`, {
            ...q,
            server: ep.server.id,
            family: ep.family,
            at: Date.parse(q.time),
          });
        }
        ep.nextPoll =
          Date.now() + (countFor(ep) > 0 ? ACTIVE_EVERY_MS : IDLE_EVERY_MS);
      } catch {
        ep.state = "error";
        ep.nextPoll = Date.now() + ERROR_EVERY_MS;
      } finally {
        ep.inFlight = false;
        render();
      }
    }

    function tick() {
      // Entries are final once stored; only age removes them.
      const cutoff = Date.now() - windowMs;
      for (const [key, row] of rows) {
        if (row.at < cutoff) rows.delete(key);
      }

      if (!document.hidden && live()) {
        const now = Date.now();
        for (const ep of endpoints) {
          if (!ep.inFlight && ep.nextPoll <= now) void poll(ep);
        }
      }
      liveButton.textContent = live() ? "Pause" : "Resume live updates";
      render();
    }

    function statusCell(ep: Endpoint) {
      const value = cells.get(ep)!;
      const card = value.closest<HTMLElement>(".ll-card")!;
      value.title = "";
      if (ep.state === "pending") {
        value.textContent = "…";
        value.className = "ll-muted";
      } else if (ep.state === "error") {
        value.textContent = "–";
        value.title = "Not reachable from this browser";
        value.className = "ll-muted";
      } else {
        const n = countFor(ep);
        value.textContent = n === 0 ? "none" : String(n);
        value.className = n === 0 ? "ll-muted" : "ll-active";
      }
      const inUse = endpoints.some(
        (e) => e.server === ep.server && countFor(e) > 0,
      );
      card.classList.toggle("ll-in-use", inUse);
    }

    function chip(text: string, kind = "") {
      const span = document.createElement("span");
      span.className = `ll-chip ${kind}`.trim();
      span.textContent = text;
      return span;
    }

    function renderSummary() {
      const pending = endpoints.some((e) => e.state === "pending");
      const v6 = endpoints.filter((e) => e.family === "ipv6");
      const ip4 = endpoints.find(
        (e) => e.family === "ipv4" && e.clientIp,
      )?.clientIp;
      const ip6 = v6.find((e) => e.clientIp)?.clientIp;
      const using = endpoints
        .filter((e) => countFor(e) > 0)
        .map((e) => `${e.server.id} ${e.family === "ipv4" ? "v4" : "v6"}`);

      const chips: HTMLElement[] = [];
      if (using.length > 0) {
        chips.push(chip("Using", "ll-chip-label"));
        for (const u of using) chips.push(chip(u, "ll-chip-on"));
      } else if (endpoints.every((e) => e.state === "error")) {
        chips.push(
          chip(
            "Couldn't reach any server. Check your connection or ad blocker.",
            "ll-chip-warn",
          ),
        );
      } else if (pending) {
        chips.push(chip("Checking every server…", "ll-muted"));
      } else {
        chips.push(
          chip(
            `No lookups from you in the last ${Math.round(windowMs / 60_000)} minutes`,
            "ll-chip-warn",
          ),
        );
      }
      if (ip4) chips.push(chip(`IPv4 ${ip4}`));
      if (ip6) chips.push(chip(`IPv6 ${ip6}`));
      if (
        !pending &&
        v6.every((e) => e.state === "error") &&
        endpoints.some((e) => e.family === "ipv4" && e.state === "ok")
      ) {
        chips.push(chip("No IPv6 on this network", "ll-muted"));
      }
      summary.replaceChildren(...chips);
    }

    function answerText(row: Row): string {
      if (row.answers.length === 0) return row.rcode;
      return row.answers
        .map((a) =>
          a.type === "A" || a.type === "AAAA" ? a.data : `${a.type} ${a.data}`,
        )
        .join(", ");
    }

    function renderTable() {
      const needle = filter.value.trim().toLowerCase();
      const visible = [...rows.values()]
        .filter((r) => !blockedOnly.checked || r.blocked)
        .filter((r) => !needle || r.name.toLowerCase().includes(needle))
        .sort((a, b) => b.at - a.at || b.seq - a.seq);

      const fragment = document.createDocumentFragment();
      for (const row of visible.slice(0, MAX_ROWS)) {
        const tr = document.createElement("tr");

        const time = document.createElement("td");
        time.className = "ll-nowrap ll-muted";
        time.textContent = new Date(row.at).toLocaleTimeString();

        const name = document.createElement("td");
        name.className = "ll-name";
        const code = document.createElement("code");
        code.textContent = row.name;
        const type = document.createElement("span");
        type.className = "ll-type";
        type.textContent = row.type;
        name.append(code, " ", type);

        const result = document.createElement("td");
        result.className = "ll-result";
        if (row.blocked) {
          const badge = document.createElement("span");
          badge.className = "ll-badge";
          badge.textContent = "Blocked";
          result.append(badge);
        } else {
          const answer = document.createElement("div");
          answer.className = "ll-answer";
          answer.textContent = answerText(row);
          result.append(answer);
        }
        const via = document.createElement("div");
        via.className = "ll-via ll-muted";
        via.textContent = `${row.server} · ${row.family === "ipv4" ? "IPv4" : "IPv6"}`;
        result.append(via);

        tr.append(time, name, result);
        fragment.append(tr);
      }
      tableBody.replaceChildren(fragment);

      if (rows.size === 0) {
        note.textContent = "No lookups to show yet.";
      } else if (visible.length > MAX_ROWS) {
        note.textContent = `Showing the newest ${MAX_ROWS} of ${visible.length}.`;
      } else {
        note.textContent = "";
      }
    }

    function render() {
      for (const ep of endpoints) statusCell(ep);
      renderSummary();
      renderTable();
    }

    filter.addEventListener("input", renderTable);
    blockedOnly.addEventListener("change", renderTable);
    liveButton.addEventListener("click", () => {
      liveUntil = live() ? 0 : Date.now() + LIVE_FOR_MS;
      if (live()) for (const ep of endpoints) ep.nextPoll = 0;
      tick();
    });
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) tick();
    });

    render();
    tick();
    setInterval(tick, 1_000);
  }

  for (const root of document.querySelectorAll<HTMLElement>(".live-logs"))
    setup(root);
</script>

<style is:global>
  /* Global, not scoped: the rows and cells are built by the script at
     runtime, and Astro's scoping attribute only reaches elements in this
     file's markup. Every selector starts at .live-logs instead. */
  .live-logs {
    margin-top: 1rem;
  }

  .live-logs .ll-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .live-logs .ll-chip {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-hairline-light);
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }

  .live-logs .ll-chip-label {
    border-color: transparent;
    padding-left: 0;
    font-weight: 600;
  }

  .live-logs .ll-chip-on {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }

  .live-logs .ll-chip-warn {
    white-space: normal;
    border-radius: 0.75rem;
    background: var(--sl-color-orange-low);
    border-color: var(--sl-color-orange);
    color: var(--sl-color-orange-high);
  }

  .live-logs .ll-servers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.25rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .live-logs .ll-card {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: var(--sl-text-sm);
  }

  .live-logs .ll-card.ll-in-use {
    border-color: var(--sl-color-accent);
  }

  .live-logs .ll-card-title {
    margin-bottom: 0.25rem;
  }

  .live-logs .ll-card-title span {
    display: block;
    font-size: var(--sl-text-xs);
  }

  .live-logs .ll-card-line {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .live-logs .ll-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .live-logs .ll-filter {
    flex: 1 1 12rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
  }

  .live-logs .ll-live {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .live-logs .ll-table-wrap {
    overflow-x: auto;
  }

  .live-logs table {
    border-collapse: collapse;
    width: 100%;
    font-size: var(--sl-text-sm);
  }

  .live-logs th,
  .live-logs td {
    text-align: left;
    vertical-align: top;
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .live-logs th {
    color: var(--sl-color-gray-3);
    font-weight: 600;
  }

  .live-logs .ll-muted {
    color: var(--sl-color-gray-3);
  }

  .live-logs .ll-active {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .live-logs .ll-nowrap {
    white-space: nowrap;
  }

  .live-logs .ll-name {
    word-break: break-all;
  }

  .live-logs .ll-type {
    display: inline-block;
    margin-left: 0.25rem;
    padding: 0 0.35rem;
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    word-break: normal;
  }

  .live-logs .ll-result {
    min-width: 12rem;
  }

  .live-logs .ll-answer {
    word-break: break-all;
  }

  .live-logs .ll-via {
    font-size: var(--sl-text-xs);
  }

  .live-logs .ll-badge {
    display: inline-block;
    padding: 0 0.4rem;
    border-radius: 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    background: var(--sl-color-red-low);
    color: var(--sl-color-red-high);
  }

  .live-logs .ll-note {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
</style>
